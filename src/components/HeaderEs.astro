<header class="relative px-6 py-16 sm:px-10 md:px-16 lg:pt-32 lg:pb-24 overflow-hidden">
    <!-- Blobs decorativos de fondo (ajustados para no romper el layout en móvil) -->
    <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 md:w-96 md:h-96 rounded-full bg-purple-200  blur-3xl opacity-50 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -ml-16 -mb-16 w-56 h-56 md:w-80 md:h-80 rounded-full bg-orange-100  blur-3xl opacity-50 pointer-events-none"></div>

    <div class="max-w-7xl mx-auto relative z-10">
        <div class="max-w-4xl">
            <!-- Título: Se ajustaron los tamaños de texto para cada breakpoint -->
            <h1 class="display font-playfair text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-medium leading-[1.1] mb-8 bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-slate-700 to-slate-900">
                Desarrollo con<br/>
                <span class="italic text-[#6366f1] font-serif">perspectiva.</span>
            </h1>

            <!-- Párrafo: Ajuste de tamaño y lectura -->
            <p class="text-base sm:text-lg md:text-xl text-slate-600 leading-relaxed max-w-2xl mb-10">
                Hola, soy Javier. Estudio Ciencias de la Computación y dedico mi tiempo a construir herramientas digitales sencillas y funcionales. Disfruto del proceso de aprendizaje que hay detrás de cada proyecto, buscando siempre escribir código limpio y que sea realmente útil para quienes lo usan.
            </p>

            <!-- Botones: Stack vertical en móvil, horizontal en desktop -->
            <div class="flex flex-col sm:flex-row gap-4">
                <a class="inline-flex items-center justify-center px-8 py-3.5 bg-slate-900  text-white  font-medium rounded-full hover:bg-slate-800  transition-all duration-300 shadow-sm" href="#work">
                    Ver Proyectos
                </a>
                <a class="inline-flex items-center justify-center px-8 py-3.5 border border-slate-300  text-slate-700 font-medium rounded-full hover:bg-slate-50  transition-all duration-300" href="#contact">
                    Hablemos
                </a>
            </div>
        </div>
    </div>
</header>