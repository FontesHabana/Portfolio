@media(max-width:650px){.terminal-site{padding:8px 6px 28px}.terminal-shell{padding:0 17px 8px;border-radius:7px}.window-bar{margin:0 -17px;padding:9px 12px}.window-meta{display:none}.terminal-top{gap:8px}.terminal-top nav{gap:10px}.hero{align-items:flex-start}.hero img{width:86px;height:86px}.project-grid{grid-template-columns:1fr}.project-image{height:180px}.terminal-console label{font-size:10px}}
