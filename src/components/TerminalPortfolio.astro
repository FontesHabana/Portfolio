---
import { getCollection } from "astro:content";
const lang = Astro.props.lang === "es" ? "es" : "en";
const es = lang === "es";
const prefix = es ? "/es" : "";
const projects = (await getCollection("projects", ({ id }) => id.startsWith(lang + "/"))).map(p => ({...p.data, slug: p.id.split("/").pop()?.toLowerCase() || ""}));
const labels = es ? {about:"sobre mí",projects:"proyectos",stack:"tecnologías",contact:"contacto",intro:"Estudiante de Ciencias de la Computación y desarrollador de software. Me gusta convertir problemas complejos en herramientas sencillas y útiles.",aboutText:"Creo en el código limpio, las interfaces accesibles y aprender construyendo. Mi objetivo es desarrollar software que resuelva problemas reales.",featured:"Proyectos seleccionados",all:"Ver todos los proyectos",contactText:"¿Tienes una idea o una oportunidad? Hablemos.",help:"Prueba los comandos: help, about, projects, skills, contact, clear",command:"Escribe un comando…",open:"Abrir proyecto"} : {about:"about",projects:"projects",stack:"stack",contact:"contact",intro:"Computer Science student and software developer. I enjoy turning complex problems into simple, useful tools.",aboutText:"I believe in clean code, accessible interfaces, and learning by building. My goal is to create software that solves real problems.",featured:"Selected projects",all:"Browse all projects",contactText:"Have an idea or an opportunity? Let's talk.",help:"Try commands: help, about, projects, skills, contact, clear",command:"Type a command…",open:"Open project"};
---
<div class="terminal-site" data-terminal-lang={lang}>
  <div class="terminal-shell">
    <div class="window-bar"><div class="window-controls" aria-hidden="true"><i></i><i></i><i></i></div><span>fontes@portfolio — ~/home</span><span class="window-meta">zsh · 100×36</span></div><header class="terminal-top"><a href={prefix + "/"} class="brand">fontes<span>@portfolio</span>:~</a><span class="status"><span class="status-dot"></span> online</span><nav aria-label="Main navigation"><a href="#about">{labels.about}</a><a href="#projects">{labels.projects}</a><a href="#skills">{labels.stack}</a><a href="#contact">{labels.contact}</a><a href={es ? "/" : "/es/"} lang={es ? "en" : "es"}>{es ? "EN" : "ES"}</a></nav></header>
    <div class="terminal-intro"><div class="boot-lines"><span>Last login: today on ttys001</span><span>Welcome to Javier Fontes Basabe\'s workspace.</span><span>Type <b>help</b> to explore available commands.</span></div><span class="comment"># javier-fontes-basabe / portfolio</span><div class="prompt">fontes@portfolio:~$ <span>whoami</span></div><div class="hero"><img src="/assets/yo.webp" alt="Javier Fontes Basabe" width="120" height="120" loading="eager"/><div><p class="eyebrow">~/javier-fontes-basabe</p><h1>Javier Fontes Basabe<span class="cursor" aria-hidden="true">_</span></h1><p class="subtitle">Computer Science Student <span>·</span> Software Developer</p><p class="description">{labels.intro}</p><div class="hero-links"><a href="https://github.com/FontesHabana" target="_blank" rel="noopener noreferrer">↗ GitHub</a><a href="https://www.linkedin.com/in/javier-fontes-basabe" target="_blank" rel="noopener noreferrer">↗ LinkedIn</a><a href="mailto:javierfontbas@gmail.com">↗ Email</a></div></div></div></div>
    <section id="about" class="terminal-section"><div class="prompt">fontes@portfolio:~$ <span>cat about.md</span></div><h2>{es ? "Sobre mí" : "About me"}</h2><p>{labels.aboutText}</p><p class="muted">{es ? "Me interesa el desarrollo web, la ingeniería de software y la inteligencia artificial." : "I'm interested in web development, software engineering, and artificial intelligence."}</p></section>
    <section id="projects" class="terminal-section"><div class="prompt">fontes@portfolio:~$ <span>ls ~/projects/</span></div><div class="section-heading"><h2>{labels.featured}</h2><a href={prefix + "/project"}>{labels.all} ↗</a></div><div class="project-grid">{projects.map(p => <a class="project" href={prefix + "/projects/" + (p.link || p.slug).toLowerCase()}><div class="project-image"><img class="project-backdrop" src={p.imgbg || p.imgfront} alt="" loading="lazy"/><img class="project-foreground" src={p.imgfront || p.imgbg} alt={p.title} loading="lazy"/></div><div class="project-body"><span class="folder">drwxr-xr-x&nbsp; {p.title}/</span><p>{p.subtitle}</p><div class="tags">{(p.tech || []).map(t => <span>{t}</span>)}</div><span class="project-open">{labels.open} ↗</span></div></a>)}</div></section>
    <section id="skills" class="terminal-section"><div class="prompt">fontes@portfolio:~$ <span>cat stack.json</span></div><h2>{es ? "Tecnologías" : "Tech stack"}</h2><pre class="stack" aria-label="Technology stack">{JSON.stringify({languages:["Python","JavaScript","C++","C#"],frontend:["Astro","React","Tailwind CSS","HTML","CSS"],tools:["Git","GitHub","VS Code"]},null,2)}</pre></section>
    <section id="contact" class="terminal-section"><div class="prompt">fontes@portfolio:~$ <span>./contact.sh</span></div><h2>{es ? "Contacto" : "Get in touch"}</h2><p>{labels.contactText}</p><a class="email" href="mailto:javierfontbas@gmail.com">javierfontbas@gmail.com ↗</a></section>
    <section class="terminal-console" aria-label="Interactive terminal"><div class="console-heading"><span>interactive shell</span><span>● ready</span></div><div class="console-history" id="terminal-history" aria-live="polite"><p class="muted" id="terminal-output">{labels.help}</p></div><form id="terminal-form" autocomplete="off"><label for="terminal-input">fontes@portfolio:~$</label><input id="terminal-input" name="command" aria-label={labels.command} placeholder={labels.command} spellcheck="false"/><button type="submit" aria-label="Run command">↵</button></form></section>
    <footer>© {new Date().getFullYear()} Javier Fontes Basabe <span>built with Astro · <a href="https://github.com/FontesHabana/Portfolio">source ↗</a></span></footer>
  </div>
</div>
<script>
  function initTerminal() {
    const root = document.querySelector(".terminal-site");
    const form = root?.querySelector("#terminal-form");
    const input = root?.querySelector("#terminal-input");
    const output = root?.querySelector("#terminal-output");
    const history = root?.querySelector("#terminal-history");
    if (!root || !form || !input || !output || form.dataset.ready) return;
    form.dataset.ready = "true";
    form.addEventListener("submit", event => {
      event.preventDefault();
      const cmd = input.value.trim().toLowerCase();
      const commands = {about:"about",projects:"projects",ls:"projects",skills:"skills",stack:"skills",contact:"contact",help:null};
      if (cmd === "clear") { history.replaceChildren(); }
      else if (cmd in commands) {
        const section = commands[cmd];
        const line = document.createElement("p"); line.textContent = "fontes@portfolio:~$ " + cmd; history.append(line); const response = document.createElement("p"); response.className = "console-response"; response.textContent = section ? "Opening ~/" + section + "/" : "Available: help · about · projects · skills · contact · clear"; history.append(response);
        if (section) root.querySelector("#" + section)?.scrollIntoView({behavior:"smooth"});
      } else if (cmd) { const line = document.createElement("p"); line.textContent = "fontes@portfolio:~$ " + cmd; history.append(line); const response = document.createElement("p"); response.className = "console-response"; response.textContent = "zsh: command not found: " + cmd + " · try help"; history.append(response); }
      input.value = "";
    });
  }
  document.addEventListener("astro:page-load",initTerminal);
  initTerminal();
</script>
<style>
:global(html){scroll-behavior:smooth} :global(body){margin:0;background:#0a0f12;color:#dce6e0}
.terminal-site{--accent:#80e4ae;--muted:#8c9b98;min-height:100vh;background:radial-gradient(ellipse at 80% 0%,#14231f 0%,transparent 40%),#0a0f12;color:#dce6e0;font:15px/1.75 ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace}
.terminal-shell{max-width:1100px;margin:auto;padding:0 28px}.terminal-top{display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid #293632;padding:24px 0;flex-wrap:wrap}.brand{color:var(--accent);font-weight:700;text-decoration:none}.brand span{color:#b9c8c1}.status{color:var(--muted);font-size:12px}.status-dot{display:inline-block;width:7px;height:7px;background:var(--accent);border-radius:50%;margin-right:5px}.terminal-top nav{display:flex;gap:18px;flex-wrap:wrap}.terminal-top a,.section-heading a,.hero-links a,footer a{color:#b3c5bc;text-decoration:none}.terminal-top a:hover,.section-heading a:hover,.hero-links a:hover,footer a:hover{color:var(--accent)}.terminal-intro{padding:65px 0 56px}.comment,.muted{color:var(--muted)}.comment{font-size:12px}.prompt{color:var(--accent);margin:18px 0 22px;font-size:13px}.prompt span{color:#e5ece7}.hero{display:flex;gap:30px;align-items:flex-start}.hero img{width:120px;height:120px;object-fit:cover;border-radius:8px;filter:grayscale(.2);border:1px solid #32443a}.eyebrow{font-size:12px;color:var(--accent);margin:0}h1{font-size:clamp(28px,5vw,52px);letter-spacing:-.055em;line-height:1.2;margin:8px 0 10px;font-weight:650}.cursor{color:var(--accent);animation:blink 1s step-end infinite}@keyframes blink{50%{opacity:0}}.subtitle{color:#a4b7ad;margin:0}.subtitle span{color:var(--accent)}.description{max-width:690px;color:#c3d0c9;margin:18px 0}.hero-links{display:flex;gap:20px;flex-wrap:wrap;font-size:13px}.terminal-section{padding:44px 0 55px;border-top:1px dashed #304039;scroll-margin-top:20px}.terminal-section h2{font-size:21px;color:#eef7f1;font-weight:600;margin:0 0 18px}.terminal-section>p{max-width:780px}.section-heading{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}.section-heading a{font-size:13px}.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.project{border:1px solid #293c34;background:#101a17;color:inherit;text-decoration:none;border-radius:8px;overflow:hidden;transition:border-color .2s,transform .2s}.project:hover{border-color:var(--accent);transform:translateY(-3px)}.project-image{height:160px;background:#16221c;overflow:hidden}.project-image img{width:100%;height:100%;object-fit:cover;object-position:top}.project-body{padding:20px}.folder{color:var(--accent);font-weight:600}.project-body p{color:#b5c3ba;font-size:13px;min-height:48px}.tags{display:flex;flex-wrap:wrap;gap:6px}.tags span{font-size:11px;color:#a3cfb6;background:#1d3027;padding:2px 7px;border-radius:3px}.project-open{display:block;margin-top:18px;color:#c9e5d5;font-size:12px}.stack{color:#a9dfbd;background:#101a17;border:1px solid #293c34;padding:24px;border-radius:8px;overflow:auto;font-size:13px}.email{color:var(--accent);font-size:clamp(16px,3vw,23px);overflow-wrap:anywhere}.terminal-console{border-top:1px dashed #304039;padding:35px 0}.terminal-console p{font-size:12px}.terminal-console form{display:flex;align-items:center;gap:10px}.terminal-console label{color:var(--accent);white-space:nowrap;font-size:12px}.terminal-console input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:#fff;font:inherit}.terminal-console button{background:#1b3326;color:var(--accent);border:1px solid #38513f;border-radius:4px;padding:4px 12px;cursor:pointer}footer{border-top:1px solid #293632;padding:24px 0 35px;color:var(--muted);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:12px}
@media(max-width:650px){.terminal-shell{padding:0 18px}.terminal-top{padding:18px 0}.terminal-top nav{gap:12px;font-size:12px}.terminal-intro{padding:42px 0}.hero{flex-direction:column;gap:16px}.hero img{width:90px;height:90px}.project-grid{grid-template-columns:1fr}.terminal-section{padding:30px 0 40px}.terminal-console label{font-size:10px}}
@media(prefers-reduced-motion:reduce){.cursor{animation:none}.project{transition:none}}
</style>
<style>
/* Terminal UI refinement */
:global(body){background:#080c0b!important}
.terminal-site{--accent:#a0d9aa;--muted:#82918b;background:#080c0b;font-family:"SFMono-Regular",Consolas,"Liberation Mono",monospace;font-size:13px;line-height:1.7;letter-spacing:-.012em;padding:32px 20px 64px}
.terminal-shell{max-width:1060px;padding:0 36px 8px;background:#101613;border:1px solid #344139;border-radius:11px;box-shadow:0 28px 90px #0009,0 0 0 1px #ffffff05;overflow:hidden}
.window-bar{display:flex;align-items:center;justify-content:space-between;margin:0 -36px;padding:10px 18px;background:#1c2520;border-bottom:1px solid #36453b;color:#a4afa7;font-size:11px;letter-spacing:0}.window-controls{display:flex;gap:7px}.window-controls i{display:block;width:10px;height:10px;border-radius:50%;background:#e26b63}.window-controls i:nth-child(2){background:#dfb85b}.window-controls i:nth-child(3){background:#69b979}.window-meta{color:#74867b}
.terminal-top{padding:18px 0;border-bottom:1px solid #27372d}.terminal-top nav{gap:16px}.terminal-top nav a{font-size:12px}.brand{font-size:13px}.terminal-intro{padding:28px 0 35px}.boot-lines{display:flex;flex-direction:column;color:#718a79;font-size:11px;margin-bottom:26px}.boot-lines b{color:var(--accent);font-weight:500}.comment{color:#748b78;font-size:11px}.prompt{font-size:12px;margin:13px 0 15px;color:#a2d5a5}.hero{gap:24px;align-items:center}.hero img{width:104px;height:104px;border:1px solid #415044;border-radius:5px}.eyebrow{font-size:11px}.hero h1{font-size:clamp(24px,3.5vw,37px);font-weight:600;letter-spacing:-.045em;margin:5px 0 6px}.subtitle{font-size:12px}.description{font-size:13px;max-width:620px;margin:13px 0}.hero-links{font-size:12px;gap:16px}.terminal-section{padding:28px 0 35px;border-top:1px dashed #354238}.terminal-section h2{font-size:17px;font-weight:600;letter-spacing:-.035em;margin-bottom:13px}.terminal-section>p{font-size:13px;line-height:1.8}.project-grid{gap:12px}.project{background:#151e18;border-color:#344238;border-radius:5px}.project-image{height:175px;position:relative;background:#1b2620;isolation:isolate}.project-backdrop{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:brightness(.7)}.project-foreground{position:absolute;z-index:1;inset:7% 8%;width:84%;height:86%;object-fit:contain;filter:drop-shadow(0 12px 20px #0009)}.project-body{padding:15px}.folder{font-size:12px}.project-body p{font-size:12px;min-height:35px}.project-open{margin-top:12px}.tags span{font-size:10px;background:#26382c}.stack{font-size:12px;line-height:1.7;border-radius:4px;background:#0d1410}.email{font-size:17px}.terminal-console{padding:25px 0}.console-heading{display:flex;justify-content:space-between;font-size:11px;color:#8ea693;border-bottom:1px solid #304135;padding-bottom:9px}.console-heading span:last-child{color:var(--accent)}.console-history{max-height:220px;overflow:auto;padding:12px 0;font-size:12px}.console-history p{margin:3px 0}.console-response{color:var(--accent)}.terminal-console form{background:#0b110d;border:1px solid #324535;border-radius:4px;padding:10px 12px}.terminal-console input{font-size:12px}.terminal-console button{font-size:13px}footer{font-size:11px}
@media(max-width:650px){.terminal-site{padding:8px 6px 28px}.terminal-shell{padding:0 17px 8px;border-radius:7px}.window-bar{margin:0 -17px;padding:9px 12px}.window-meta{display:none}.terminal-top{gap:8px}.terminal-top nav{gap:10px}.hero{align-items:flex-start}.hero img{width:86px;height:86px}.project-grid{grid-template-columns:1fr}.project-image{height:180px}.terminal-console label{font-size:10px}}
</style>