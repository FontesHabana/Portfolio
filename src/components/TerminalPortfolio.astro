---
import { getCollection } from "astro:content";
const lang = Astro.props.lang === "es" ? "es" : "en";
const es = lang === "es";
const prefix = es ? "/es" : "";
const projects = (await getCollection("projects", ({ id }) => id.startsWith(lang + "/"))).map(p => ({...p.data, slug: p.id.split("/").pop()?.toLowerCase() || ""}));
const labels = es ? {about:"sobre mí",projects:"proyectos",stack:"tecnologías",contact:"contacto",intro:"Estudiante de Ciencias de la Computación y desarrollador de software. Me gusta convertir problemas complejos en herramientas sencillas y útiles.",aboutText:"Creo en el código limpio, las interfaces accesibles y aprender construyendo. Mi objetivo es desarrollar software que resuelva problemas reales.",featured:"Proyectos seleccionados",all:"Ver todos los proyectos",contactText:"¿Tienes una idea o una oportunidad? Hablemos.",help:"Prueba los comandos: help, about, projects, skills, contact, clear",command:"Escribe un comando…",open:"Abrir proyecto"} : {about:"about",projects:"projects",stack:"stack",contact:"contact",intro:"Computer Science student and software developer. I enjoy turning complex problems into simple, useful tools.",aboutText:"I believe in clean code, accessible interfaces, and learning by building. My goal is to create software that solves real problems.",featured:"Selected projects",all:"Browse all projects",contactText:"Have an idea or an opportunity? Let's talk.",help:"Try commands: help, about, projects, skills, contact, clear",command:"Type a command…",open:"Open project"};
---
<div class="terminal-site" data-terminal-lang={lang}>
  <div class="terminal-shell">
    <div class="window-bar"><div class="window-controls" aria-hidden="true"><i></i><i></i><i></i></div><span>fontes@portfolio — ~/home</span><span class="window-meta">zsh · 100×36</span></div><header class="terminal-top"><a href={prefix + "/"} class="brand">fontes<span>@portfolio</span>:~</a><span class="status"><span class="status-dot"></span> online</span><nav aria-label="Main navigation"><a href="#about">{labels.about}</a><a href="#projects">{labels.projects}</a><a href="#skills">{labels.stack}</a><a href="#contact">{labels.contact}</a><a href={es ? "/" : "/es/"} lang={es ? "en" : "es"}>{es ? "EN" : "ES"}</a></nav></header>
    <div class="terminal-intro"><div class="boot-lines"><span>Last login: today on ttys001</span><span>Welcome to Javier Fontes Basabe\'s workspace.</span><span>Type <b>help</b> to explore available commands.</span></div><span class="comment"># javier-fontes-basabe / portfolio</span><div class="prompt"><span class="syntax-user">fontes@portfolio</span><span class="syntax-path">:~</span><span class="syntax-dollar">$</span> <span class="syntax-command">whoami</span></div><div class="hero"><img src="/assets/yo.webp" alt="Javier Fontes Basabe" width="120" height="120" loading="eager"/><div><p class="eyebrow">~/javier-fontes-basabe</p><h1><span class="syntax-name">Javier Fontes Basabe</span><span class="cursor" aria-hidden="true">_</span></h1><p class="subtitle">Computer Science Student <span>·</span> Software Developer</p><p class="description">{labels.intro}</p><div class="hero-links"><a href="https://github.com/FontesHabana" target="_blank" rel="noopener noreferrer">↗ GitHub</a><a href="https://www.linkedin.com/in/javier-fontes-basabe" target="_blank" rel="noopener noreferrer">↗ LinkedIn</a><a href="mailto:javierfontbas@gmail.com">↗ Email</a></div></div></div></div>
    <section id="about" class="terminal-section"><div class="prompt"><span class="syntax-user">fontes@portfolio</span><span class="syntax-path">:~</span><span class="syntax-dollar">$</span> <span class="syntax-command">cat about.md</span></div><h2><span class="syntax-heading">{es ? "Sobre mí" : "About me"}</span></h2><p>{labels.aboutText}</p><p class="muted">{es ? "Me interesa el desarrollo web, la ingeniería de software y la inteligencia artificial." : "I'm interested in web development, software engineering, and artificial intelligence."}</p></section>
    <section id="projects" class="terminal-section"><div class="prompt"><span class="syntax-user">fontes@portfolio</span><span class="syntax-path">:~</span><span class="syntax-dollar">$</span> <span class="syntax-command">ls ~/projects/</span></div><div class="section-heading"><h2><span class="syntax-heading">Projects</span> <span class="syntax-dim">— {labels.featured}</span></h2><a href={prefix + "/project"}>{labels.all} ↗</a></div><div class="carousel-toolbar"><span class="carousel-counter" id="project-counter">01 / {String(projects.length).padStart(2,"0")}</span><div class="carousel-actions"><button type="button" id="project-prev" aria-label={es ? "Proyecto anterior" : "Previous project"}>‹</button><button type="button" id="project-next" aria-label={es ? "Proyecto siguiente" : "Next project"}>›</button></div></div><div class="project-grid" id="project-carousel" tabindex="0" aria-label={labels.featured}>{projects.map(p => <a class="project" href={prefix + "/projects/" + (p.link || p.slug).toLowerCase()}><div class="project-image"><img class="project-backdrop" src={p.imgbg || p.imgfront} alt="" loading="lazy"/><img class="project-foreground" src={p.imgfront || p.imgbg} alt={p.title} loading="lazy"/></div><div class="project-body"><span class="folder"><span class="syntax-dim">drwxr-xr-x</span>&nbsp; {p.title}/</span><p>{p.subtitle}</p><div class="tags">{(p.tech || []).map(t => <span>{t}</span>)}</div><span class="project-open">{labels.open} ↗</span></div></a>)}</div><div class="carousel-indicators" id="project-indicators" role="group" aria-label={es ? "Elegir proyecto" : "Select project"}>{projects.map((p,i) => <button type="button" class="carousel-indicator" data-project-index={i} aria-label={`${es ? "Mostrar" : "Show"} ${p.title}`} aria-pressed={i === 0 ? "true" : "false"}><span></span></button>)}</div></section>
    <section id="skills" class="terminal-section"><div class="prompt"><span class="syntax-user">fontes@portfolio</span><span class="syntax-path">:~</span><span class="syntax-dollar">$</span> <span class="syntax-command">cat stack.json</span></div><h2><span class="syntax-heading">{es ? "Tecnologías" : "Tech stack"}</span></h2><pre class="stack" aria-label="Technology stack">{JSON.stringify({languages:["Python","JavaScript","C++","C#"],frontend:["Astro","React","Tailwind CSS","HTML","CSS"],tools:["Git","GitHub","VS Code"]},null,2)}</pre></section>
    <section id="contact" class="terminal-section"><div class="prompt"><span class="syntax-user">fontes@portfolio</span><span class="syntax-path">:~</span><span class="syntax-dollar">$</span> <span class="syntax-command">./contact.sh</span></div><h2><span class="syntax-heading">{es ? "Contacto" : "Get in touch"}</span></h2><p>{labels.contactText}</p><a class="email" href="mailto:javierfontbas@gmail.com">javierfontbas@gmail.com ↗</a></section>
    <section class="terminal-console" aria-label="Interactive terminal"><div class="console-heading"><span>interactive shell</span><span>● ready</span></div><div class="console-history" id="terminal-history" aria-live="polite"><p class="muted" id="terminal-output">{labels.help}</p></div><form id="terminal-form" autocomplete="off"><label for="terminal-input">fontes@portfolio:~$</label><input id="terminal-input" name="command" aria-label={labels.command} placeholder={labels.command} spellcheck="false"/><button type="submit" aria-label="Run command">↵</button></form></section>
    <footer>© {new Date().getFullYear()} Javier Fontes Basabe <span>built with Astro · <a href="https://github.com/FontesHabana/Portfolio">source ↗</a></span></footer>
  </div>
</div>
<script>
  function initTerminal() {
    const root = document.querySelector(".terminal-site");
    const controller = new AbortController();
    const form = root?.querySelector("#terminal-form");
    const input = root?.querySelector("#terminal-input");
    const output = root?.querySelector("#terminal-output");
    const carousel = root?.querySelector("#project-carousel");
    const cards = Array.from(carousel?.querySelectorAll(".project") || []);
    const counter = root?.querySelector("#project-counter");
    let index = 0;
    const showProject = (next) => { if (!cards.length) return; index = (next + cards.length) % cards.length; cards.forEach((card,i) => {card.hidden = i !== index; card.setAttribute("aria-hidden",String(i !== index)); card.tabIndex = i === index ? 0 : -1;}); if(counter) counter.textContent = String(index+1).padStart(2,"0")+" / "+String(cards.length).padStart(2,"0"); };
    root.querySelector("#project-prev")?.addEventListener("click",()=>showProject(index-1));
    root.querySelector("#project-next")?.addEventListener("click",()=>showProject(index+1));
    carousel?.addEventListener("keydown",(event)=>{if(event.key==="ArrowLeft"||event.key==="ArrowRight"){event.preventDefault();showProject(index+(event.key==="ArrowRight"?1:-1));}});
    const indicators = Array.from(root.querySelectorAll(".carousel-indicator"));
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let autoTimer;
    let paused = false;
    const previousShowProject = showProject;
    // Keep the project markers synchronized with the existing carousel state.
    const syncIndicators = () => indicators.forEach((dot,i) => dot.setAttribute("aria-pressed",String(i === index)));
    const navigate = (next) => { previousShowProject(next); syncIndicators(); };
    const stopAuto = () => { if(autoTimer) window.clearInterval(autoTimer); autoTimer = undefined; };
    const startAuto = () => { stopAuto(); if (!reduceMotion.matches && !paused && cards.length > 1 && !document.hidden) autoTimer = window.setInterval(() => navigate(index + 1), 5000); };
    indicators.forEach((dot,i) => dot.addEventListener("click",() => { navigate(i); startAuto(); }));
    root.querySelector("#project-prev")?.addEventListener("click",syncIndicators);
    root.querySelector("#project-next")?.addEventListener("click",syncIndicators);
    carousel?.addEventListener("keydown",syncIndicators);
    const projectsSection = root.querySelector("#projects");
    projectsSection?.addEventListener("mouseenter",() => { paused = true; stopAuto(); });
    projectsSection?.addEventListener("mouseleave",() => { paused = false; startAuto(); });
    projectsSection?.addEventListener("focusin",() => { paused = true; stopAuto(); });
    projectsSection?.addEventListener("focusout",(event) => { if (!projectsSection.contains(event.relatedTarget)) { paused = false; startAuto(); } });
    document.addEventListener("visibilitychange",() => { if(document.hidden) stopAuto(); else startAuto(); },{signal: controller.signal});
    reduceMotion.addEventListener?.("change",startAuto,{signal:controller.signal});
    showProject(0);
    syncIndicators();
    startAuto();
    const history = root?.querySelector("#terminal-history");
    if (!root || !form || !input || !output || form.dataset.ready) return;
    form.dataset.ready = "true";
    form.addEventListener("submit", event => {
      event.preventDefault();
      const cmd = input.value.trim().toLowerCase();
      const commands = {about:"about",projects:"projects",ls:"projects",skills:"skills",stack:"skills",contact:"contact",help:null};
      if (cmd === "clear") { history.replaceChildren(); }
      else if (cmd in commands) {
        const section = commands[cmd];
        const line = document.createElement("p"); line.textContent = "fontes@portfolio:~$ " + cmd; history.append(line); const response = document.createElement("p"); response.className = "console-response"; response.textContent = section ? "Opening ~/" + section + "/" : "Available: help · about · projects · skills · contact · clear"; history.append(response);
        if (section) root.querySelector("#" + section)?.scrollIntoView({behavior:"smooth"});
      } else if (cmd) { const line = document.createElement("p"); line.textContent = "fontes@portfolio:~$ " + cmd; history.append(line); const response = document.createElement("p"); response.className = "console-response"; response.textContent = "zsh: command not found: " + cmd + " · try help"; history.append(response); }
      input.value = "";
    });
  }
  document.addEventListener("astro:page-load",initTerminal);
  initTerminal();
</script>
<style>
