---
// 1. Importar las transiciones de Astro
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css'; // Asumiendo que crearás este archivo
// Supports weights 400-900
import '@fontsource-variable/playfair-display';
// Supports weights 100-900
import '@fontsource-variable/inter';
import Header from '../components/Header.astro';

import Dropdown from "../components/DropDown.jsx";

// 2. Definir las Props (para cambiar el título de cada página)
interface Props {
	title: string;
    lang?: string;
}



const { title, lang = "es" } = Astro.props;






import { getLangFromUrl, useTranslations } from '../i18n/utils';

const langu = getLangFromUrl(Astro.url);
const t = useTranslations(langu);

// 1. Asegúrate de definir esta variable
const currentPath = Astro.url.pathname; 

const labels = {
  menuOpen: t('menuOpen'),
  menuClose: t('menuClose'),
  navInicio: t('navInicio'),
  navSobreMi: t('navSobreMi'),
  navProyectos: t('navProyectos'),
  navContacto: t('navContacto'),
};



---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/assets/firma.webp" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
        <!-- Activa las transiciones automáticas entre páginas -->
        <ClientRouter />

        <!-- Script para evitar el parpadeo blanco en Modo Oscuro -->
        <script is:inline>
            const theme = (() => {
                if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
                    return localStorage.getItem('theme');
                }
                if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    return 'dark';
                }
                return 'light';
            })();
          
            if (theme === 'light') {
                document.documentElement.classList.remove('dark');
            } else {
                document.documentElement.classList.add('dark');
            }
        </script>
	</head>
    
	<body >
		<nav class="fixed top-0 right-0 w-full justify-end z-50 flex p-6">
    <Dropdown 
  client:load 
  lang={langu} 
  t={labels} 
  currentPath={currentPath} 
/>
  </nav>
        <nav>
            <!-- Aquí irá tu componente de navegación más adelante -->
        </nav>

        <main>
            <!-- El SLOT es donde se inyectará el contenido de cada página -->
            <slot /> 
        </main>

        <footer>
            <!-- Tu pie de página -->
        </footer>

	</body>
</html>

<style is:global>
html{
    font-family: system-ui,  sans-serif;
    
}
body{
    
    justify-content: center;
}

.display{
    font-family: "Playfair Display Variable", serif;
}
.inter{
    font-family: "Inter Variable", sans-serif;
}

</style>