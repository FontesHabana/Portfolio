---
import Layout from "../layouts/Layout.astro";
//import BackgroundLines from '../components/BackgroundLines.jsx';
import {
  Github,
  Linkedin,
  ExternalLink,
  Code2,
  Terminal,
  Cpu,
  Globe,
} from "lucide-react";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";
---

<Layout title="Javier Fontes | Projects">
  <!-- Menu -->

  <main class="relative bg-purple-50  z-10 w-full min-h-screen">
    <div class="relative w-full pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
      
      <!-- Decorative Blobs (Using arbitrary values for positioning as per original intent) -->
      <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-purple-200  blur-3xl opacity-50 pointer-events-none"></div>
      <div class="absolute top-[20%] left-0 -ml-20 w-96 h-96 rounded-full bg-purple-200  blur-3xl opacity-50 pointer-events-none"></div>
      <div class="absolute top-[40%] right-0 -mr-20 w-80 h-80 rounded-full bg-orange-100  blur-3xl opacity-50 pointer-events-none"></div>
      <div class="absolute top-[60%] right-0 -mr-20 w-96 h-96 rounded-full bg-purple-200  blur-3xl opacity-50 pointer-events-none"></div>
      <div class="absolute top-[80%] left-0 -ml-20 w-80 h-80 rounded-full bg-orange-100  blur-3xl opacity-50 pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-orange-100  blur-3xl opacity-50 pointer-events-none"></div>
      
      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="max-w-4xl">
          <h1
            class="display text-5xl md:text-7xl lg:text-8xl font-medium leading-tight mb-8 bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-slate-700 to-slate-900"
          >
           Work and 
            <span class="italic text-[#6366f1] font-serif">projects.</span>
          </h1>
          <p
            class="text-lg md:text-xl text-slate-600  leading-relaxed max-w-2xl mb-10"
          >
            A collection of digital solutions, technical experiments, and tools built with attention to detail. My goal with each project is to transform complexity into something functional, simple, and useful.
          </p>
        </div>
      </div>

      <!-- Projects Section: Responsive margins -->
      <section class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20 relative" id="projects">
        <ProjectCard onlyMain={false}/>
      </section>
    </div>
  </main>

  <Footer />
</Layout>