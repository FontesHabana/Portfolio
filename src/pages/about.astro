---
import Layout from "../layouts/Layout.astro";
//import BackgroundLines from '../components/BackgroundLines.jsx';

import Dropdown from "../components/DropDown.jsx";
import Footer from "../components/Footer.astro";

import { getCollection } from 'astro:content';

import GitHubIcon from "../components/icons/GitHubIcon.astro";
import GitIcon from "../components/icons/GitIcon.astro";
import PythonIcon from "../components/icons/PythonIcon.astro";
import CSIcon from  "../components/icons/CSIcon.astro";
import CPPIcon from "../components/icons/CPPIcon.astro";
import JsIcon from "../components/icons/JsIcon.astro";
import HTMLIcon from "../components/icons/HTMLIcon.astro";
import CSSIcon from "../components/icons/CSSIcon.astro";
import ReactIcon from "../components/icons/ReactIcon.astro";
import AstroIcon from "../components/icons/AstroIcon.astro";
import TailwindIcon from "../components/icons/TailwindIcon.astro";
import StreamlitIcon from "../components/icons/StreamlitIcon.astro";

const work =  await getCollection('work', ({ id }) => {
    return id.startsWith('en/');
});

// Opcional: Ordenar por fecha (del más reciente al más antiguo)
work.sort((a, b) => Date.parse(b.data.startdate) - Date.parse(a.data.startdate));

const studies = await getCollection('studies', ({ id }) => {
    return id.startsWith('en/');
});
studies.sort((a,b)=>  Date.parse(b.data.startdate) - Date.parse(a.data.startdate))
---

<Layout title="Javier Fontes Basabe | Software Developer">

<div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">

<main class="relative sans flex-grow w-full bg-purple-50 mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <!-- Background Blobs -->
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-purple-200 dark:bg-indigo-900/30 blur-3xl opacity-50 pointer-events-none"></div>
    <div class="absolute top-[150px] left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-orange-100 dark:bg-purple-900/20 blur-3xl opacity-50 pointer-events-none"></div>

<div class="flex-grow w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <!-- Hero Section -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-24">
        <div class="order-2 md:order-1 flex flex-col gap-6">
            <h1 class="display text-3xl md:text-4xl lg:text-6xl font-medium leading-tight mb-1 bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-slate-700 to-slate-900 dark:from-white dark:via-slate-200 dark:to-slate-400">
                Structuring digital <span class="italic text-[#6366f1] font-serif">solutions.</span>
            </h1>
            <div class="prose prose-lg text-slate-600 dark:text-slate-400 leading-relaxed">
                <p>
                    I'm Javier, a software developer focused on clean code architecture and solving complex problems. I specialize in Full-Stack development, transforming ideas into robust, efficient, and scalable applications.
                </p>
                <p class="mt-4 text-base">
                    From system logic to intuitive interface design, I bridge technical solidity with a seamless user experience. My goal is to develop purposeful digital products, where code precision enhances the real software value.
                </p>
            </div>
            <div class="relative flex flex-col sm:flex-row gap-4">
                <a class="inline-flex items-center justify-center px-8 py-3.5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-medium rounded-full hover:bg-slate-800 dark:hover:bg-slate-100 transition-all duration-300" href="/Projects">
                    View Projects
                </a>
                <a class="inline-flex bg-slate-100 items-center justify-center px-8 py-3.5 border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 font-medium rounded-full hover:bg-slate-50 dark:hover:bg-slate-800 transition-all duration-300" href="#cv">
                    Download CV
                </a>
            </div>
        </div>
        <div class="order-1 md:order-2 flex justify-center md:justify-end">
            <div class="relative w-full max-w-sm aspect-square">
                <div class="absolute inset-0 bg-blue-200 dark:bg-blue-900/20 rounded-2xl rotate-3 transform transition-transform"></div>
                <div class="absolute inset-0 bg-slate-100 dark:bg-slate-800 rounded-2xl -rotate-3 transform transition-transform"></div>
                <div class="relative h-full w-full overflow-hidden rounded-2xl bg-white shadow-xl border border-slate-100 dark:border-slate-700">
                    <img src="../../public/assets/yo.webp" alt="Javier Fontes profile picture">
                </div>
            </div>
        </div>
    </section>

    <div class="w-full h-px bg-slate-200 dark:bg-slate-800 mb-20"></div>

    <!-- Tech Stack Section -->
    <section class="mb-24">                                 
        <div class="flex flex-col md:flex-row md:items-start gap-12">
            <div class="md:w-1/3 sticky top-24">
                <h2 class="text-4xl display tracking-tight text-slate-900 dark:text-white mb-4">Tech Stack</h2>
                <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
                    Focused on modern and scalable solutions, always selecting the most efficient tool for each challenge through continuous learning.
                </p>
            </div>
            <div class="md:w-2/3 grid grid-cols-1 sm:grid-cols-2 gap-8">
                <div class="space-y-4">
                    <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-500">Languages</h3>
                    <div class="flex flex-wrap gap-2">
                        <span class="flex bg-blue-100 py-1 px-4 rounded-full"> <PythonIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">Python</p></span>
                        <span class="flex bg-purple-200 py-1 px-4 rounded-full"> <CSIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">C#</p></span>
                        <span class="flex bg-purple-200 py-1 px-4 rounded-full"> <CPPIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">C++</p></span>
                        <span class="flex bg-yellow-100 py-1 px-4 rounded-full"> <JsIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">JavaScript</p></span>
                        <span class="flex bg-red-100 py-1 px-4 rounded-full"> <HTMLIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">HTML</p></span>
                        <span class="flex bg-blue-100 py-1 px-4 rounded-full"> <CSSIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">CSS</p></span>
                    </div>
                </div>
                <div class="space-y-4">
                    <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-500">Frameworks</h3>
                    <div class="flex flex-wrap gap-2">
                        <span class="flex bg-blue-100 py-1 px-4 rounded-full"> <ReactIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">React</p></span>
                        <span class="flex bg-slate-200 py-1 px-4 rounded-full"> <TailwindIcon class="w-5 h-5"/> <p class="ml-2 font-semibold ">TailwindCSS</p></span>
                        <span class="flex bg-purple-200 py-1 px-4 rounded-full"> <AstroIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">Astro</p></span>
                        <span class="flex bg-red-100 py-1 px-4 rounded-full"> <StreamlitIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">Streamlit</p></span>
                    </div>
                </div>
                <div class="space-y-4">
                    <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-500">Tools &amp; DevOps</h3>
                    <div class="flex flex-wrap gap-2">
                        <span class="flex bg-red-100 py-1 px-4 rounded-full"> <GitIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">Git</p></span>
                        <span class="flex bg-slate-300 py-1 px-4 rounded-full"> <GitHubIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">GitHub</p></span>
                    </div>
                </div>
                <div class="space-y-4">
                    <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-600 dark:text-slate-500">Design</h3>
                    <div class="flex flex-wrap gap-2">
                        <span class="flex bg-blue-300 py-1 px-4 rounded-full"> <p class=" font-semibold">UI/UX</p></span>
                        <span class="flex bg-red-200 py-1 px-4 rounded-full"> <p class=" font-semibold">Responsive Design</p></span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Experience Section -->
    <section class="mb-12">
        <div class="flex flex-col md:flex-row md:items-start gap-12">
            <div class="md:w-1/3 sticky top-24">
                <h2 class="text-4xl display tracking-tight text-slate-900 dark:text-white mb-4">Experience</h2>
                <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
                    Developing and maintaining a corporate digital ecosystem. Responsible for corporate web architecture, implementation of automation tools, and specialized technical support to ensure operational continuity.
                </p>
            </div>
            <div class="md:w-2/3 space-y-8">
                {
                    work.map((item: { slug: any; data: any; }) => {
                        const { slug, data } = item;
                        const { company, position, startdate, enddate, achivements } = data;
                        return (
                            <div class="relative pl-8 border-l border-slate-200 dark:border-slate-800 space-y-2" key={slug}>
                                <div class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-primary ring-4 ring-white dark:ring-[#111827]"></div>
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                                    <h3 class="text-lg font-bold text-slate-900 dark:text-white">{position}</h3>
                                    <span class="text-sm font-medium text-slate-500 dark:text-slate-400 tabular-nums">{startdate} — {enddate}</span>
                                </div>
                                <div class="text-primary font-medium text-sm">{company}</div>
                                {achivements && Array.isArray(achivements) && (
                                    <ul class="list-disc list-outside ml-4 mt-2 space-y-1 text-sm text-slate-600 dark:text-slate-400 marker:text-slate-400">
                                        {achivements.map((achievement: string) => (
                                            <li>{achievement}</li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Education Section -->
    <section class="mb-12">
        <div class="flex flex-col md:flex-row md:items-start gap-12">
            <div class="md:w-1/3 sticky top-24">
                <h2 class="text-4xl display tracking-tight text-slate-900 dark:text-white mb-4">Education</h2>
                <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
                    Academic path focused on solving high-complexity problems. My profile integrates the logical foundation of competitive mathematics with the rigor of algorithmic analysis and technical research, complemented by active participation in student mentoring.
                </p>
            </div>
            <div class="md:w-2/3 space-y-8">
                {
                    studies.map((item: { slug: any; data: any; }) => {
                        const { slug, data } = item;
                        const { company, level, startdate, enddate, achivements } = data;
                        return (
                            <div class="relative pl-8 border-l border-slate-200 dark:border-slate-800 space-y-2" key={slug}>
                                <div class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-primary ring-4 ring-white dark:ring-[#111827]"></div>
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                                    <h3 class="text-lg font-bold text-slate-900 dark:text-white">{level}</h3>
                                    <span class="text-sm font-medium text-slate-500 dark:text-slate-400 tabular-nums">{startdate} — {enddate}</span>
                                </div>
                                <div class="text-primary font-medium text-sm">{company}</div>
                                {achivements && Array.isArray(achivements) && (
                                    <ul class="list-disc list-outside ml-4 mt-2 space-y-1 text-sm text-slate-600 dark:text-slate-400 marker:text-slate-400">
                                        {achivements.map((achievement: string) => (
                                            <li>{achievement}</li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>
</div>

</main>

  <Footer />
</div>
</Layout>