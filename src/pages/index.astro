---
import Layout from "../layouts/Layout.astro";
//import BackgroundLines from '../components/BackgroundLines.jsx';
import PageTransition from "../components/PageTransition.jsx";
import {
  Github,
  Linkedin,
  ExternalLink,
  Code2,
  Terminal,
  Cpu,
  Globe,
} from "lucide-react";
import Dropdown from "../components/DropDown.jsx";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro"
import ProjectCard from "../components/ProjectCard.astro";
---

<Layout title="Tu Nombre | Fullstack Developer">
  <!-- Componentes de Animación -->
  <PageTransition client:load />

  <!-- Menu -->
  <nav class="fixed top-0 right-0 w-full justify-end z-50 flex p-6">
    <Dropdown client:load />
  </nav>
  <!--Presentation -->
  <Header />
  <main class="relative z-10 container mx-auto">
    <!-- 1.Projects -->
    <section class="py-20 bg-white dark:bg-slate-900/50" id="work">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-end justify-between mb-12">
          <div>
            <h2
              class="font-display text-3xl md:text-4xl text-slate-900 dark:text-white mb-2"
            >
              Selected Works
            </h2>
            <p class="text-slate-500 dark:text-slate-500">
              Curated digital products &amp; interfaces.
            </p>
          </div>
          <a
            class="hidden md:flex items-center text-primary font-medium hover:text-indigo-400 transition-colors group"
            href="#"
          >
            View all projects
            <span
              class="material-icons text-sm ml-1 group-hover:translate-x-1 transition-transform"
              >arrow_forward</span
            >
          </a>
        </div>
        <ProjectCard />
      </div>
    </section>

    <!-- 2. BENTO ABOUT SECTION -->
    <section class="py-20 mt-30 bg-slate-50 dark:bg-slate-800/50 overflow-hidden  relative" id="about">
      <div class="mx-auto px-40 ">
        <div class="absolute -bottom-10 right-0 -mr-20 -mb-20 w-96 h-96 rounded-full bg-purple-200 dark:bg-indigo-900/30 blur-3xl opacity-50 pointer-events-none"></div>
    <div class="absolute top-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-orange-100 dark:bg-purple-900/20 blur-3xl opacity-50 pointer-events-none"></div>
        <div class=" relative flex flex-col lg:flex-row gap-16 items-start">
          <div class="lg:w-1/2">
            <h2
              class="font-display text-3xl md:text-4xl text-slate-900 dark:text-white mb-6"
            >
              A minimalist approach to complex problems.
            </h2>
            <div
              class="prose dark:prose-invert text-slate-600 dark:text-slate-400"
            >
              <p class="mb-4">
                My name is Javier. I blend technical expertise with a
                photographer's eye for detail. I believe that good design is
                invisible—it just works.
              </p>
              <p>
                Inspired by the natural gradients of the sky and the structural
                integrity of city skylines, my work aims to bring a sense of
                calm and clarity to the chaotic web. Whether I'm writing clean
                code or capturing a moment in time, my goal is authenticity.
              </p>
            </div>
            
          </div>
        </div>
      </div>
    </section>



      <!-- 5. CONTACT PREVIEW -->
    <section class="py-24 bg-slate-50 px-6 text-center overflow-hidden relative " id="contact">
      <div class="absolute top-0 right-0 -mr-20 -mt-40 w-96 h-96 rounded-full bg-purple-200 dark:bg-indigo-900/30 blur-3xl opacity-50 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-orange-100 dark:bg-purple-900/20 blur-3xl opacity-50 pointer-events-none"></div>
<div class="max-w-3xl mx-auto">
  
<h2 class="font-display text-4xl md:text-5xl text-slate-900 dark:text-white mb-6">Ready to create something authentic?</h2>
<p class="text-lg text-slate-600 dark:text-slate-400 mb-10">
                I'm currently available for freelance projects and open to full-time opportunities.
            </p>
<a class="inline-flex items-center justify-center px-8 py-4 bg-slate-900 text-white font-medium text-lg rounded-full shadow-lg hover:bg-slate-700 transition-colors" href="mailto:javierfontbas@gmail.com">
                Say Hello
                <span class="material-icons ml-2">mail_outline</span>
</a>
</div>
</section>

  
    
  </main>

  <Footer />
</Layout>

<style>
  /* Suavizar el scroll al hacer clic en los enlaces del nav */
  html {
    scroll-behavior: smooth;
  }
</style>
