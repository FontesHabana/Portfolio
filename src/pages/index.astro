---
import Layout from "../layouts/Layout.astro";
//import BackgroundLines from '../components/BackgroundLines.jsx';
import {
  Github,
  Linkedin,
  ExternalLink,
  Code2,
  Terminal,
  Cpu,
  Globe,
  Mail,
} from "lucide-react";
import Dropdown from "../components/DropDown.jsx";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro"
import ProjectCard from "../components/ProjectCard.astro";
import Arrow from "../components/icons/Arrow.astro";
import  MailIcon  from "../components/icons/MailIcon.astro";
---

<Layout title="Javier Fontes | Fullstack Developer">
  <!-- Menu -->
  
  <!-- Presentation -->
  <Header />
  
  <main class="relative z-10 sans mx-auto overflow-hidden">
    <!-- 1. Projects -->
    <section class="py-20 bg-white " id="work">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
          <div>
            <h2
              class="display text-3xl md:text-4xl text-slate-900  mb-2"
            >
              Selected Works
            </h2>
            <p class="text-slate-500  max-w-xl">
              Showcasing my work in software development and functional design.
            </p>
          </div>
        </div>

        <ProjectCard onlyMain={true}/>

        <a
          class="hidden mt-20 md:flex items-center text-primary font-medium text-xl hover:text-indigo-400 transition-colors group"
          href="./Projects"
        >
          View all projects
          <div class="mt-1 group-hover:translate-x-4 transition-transform">
            <Arrow class="w-5 h-5"/>
          </div>
        </a>
      </div>
    </section>

    <!-- 2. ABOUT SECTION -->
    <section class="py-24 bg-slate-50  overflow-hidden relative" id="about">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <!-- Background Blobs -->
        <div class="absolute -bottom-10 right-0 -mr-20 -mb-20 w-96 h-96 rounded-full bg-purple-200  blur-3xl opacity-50 pointer-events-none"></div>
        <div class="absolute top-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-orange-100  blur-3xl opacity-50 pointer-events-none"></div>
        
        <div class="relative flex flex-col lg:flex-row gap-16 items-start">
          <div class="lg:w-2/3">
            <h2
              class="display text-4xl md:text-5xl text-slate-900  mb-6"
            >
               Technical simplicity for complex problems.
            </h2>
            <div
              class="prose text-lg md:text-xl  text-slate-600 "
            >
              <p class="mb-4">
                I'm Javier. As a Computer Science student, I spend most of my time trying to understand how digital tools can make our lives a bit easier. I believe that programming is, above all, a way to help others solve everyday problems.
              </p>
              <p>
                I don't aim to build the most complex system, but the one that is most useful and easy to use. In every project I undertake, I strive to learn something new and write clean, scalable code. For me, the success of a project isn't about how sophisticated it looks, but how well it works for those who need it.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. CONTACT PREVIEW -->
    <section class="py-24 bg-slate-50 px-6 text-center overflow-hidden relative" id="contact">
      <div class="absolute top-0 right-0 -mr-20 -mt-40 w-96 h-96 rounded-full bg-purple-200  blur-3xl opacity-50 pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-orange-100  blur-3xl opacity-50 pointer-events-none"></div>
      
      <div class="relative max-w-3xl mx-auto">
        <h2 class="display text-4xl md:text-5xl text-slate-900  mb-6">Ready to create something authentic?</h2>
        <p class="text-lg text-slate-600  mb-10">
          I am currently available for freelance projects and full-time opportunities.
        </p>
        <a 
          class="inline-flex items-center justify-center px-8 py-4 bg-slate-900  text-white  font-medium text-lg rounded-full shadow-lg hover:bg-slate-800  transition-colors" 
          href="mailto:javierfontbas@gmail.com?subject=Contact%20from%20your%20website&body=Hi%20Javier%2C%0A%0AI'd%20like%20to%20talk%20about%20..."
        >
          Say Hello
          <MailIcon class="w-6 h-6 ml-2"></MailIcon>
        </a>
        <p class="text-lg text-slate-600  mt-6">
          javierfontbas@gmail.com
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Smooth scroll for navigation links */
  html {
    scroll-behavior: smooth;
  }
</style>