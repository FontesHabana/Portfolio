---
import Layout from "../layouts/Layout.astro";
//import BackgroundLines from '../components/BackgroundLines.jsx';
import PageTransition from "../components/PageTransition.jsx";
import {
  Github,
  Linkedin,
  ExternalLink,
  Code2,
  Terminal,
  Cpu,
  Globe,
} from "lucide-react";
import Dropdown from "../components/DropDown.jsx";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Projects from "./projects.astro";
---

<Layout title="Tu Nombre | Fullstack Developer">
  <!-- Componentes de Animación -->
  <PageTransition client:load />

  <!-- Menu -->
  <nav class="fixed top-0 right-0 w-full justify-end z-50 flex p-6">
    <Dropdown client:load />
  </nav>
   <!--Presentation -->
  <Header />
  <main class="relative z-10 container mx-auto px-6">
    <!-- 1.Projects -->
    <section class="py-20 bg-white dark:bg-slate-900/50" id="work">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-end justify-between mb-12">
          <div>
            <h2
              class="font-display text-3xl md:text-4xl text-slate-900 dark:text-white mb-2"
            >
              Selected Works
            </h2>
            <p class="text-slate-500 dark:text-slate-500">
              Curated digital products &amp; interfaces.
            </p>
          </div>
          <a
            class="hidden md:flex items-center text-primary font-medium hover:text-indigo-400 transition-colors group"
            href="#"
          >
            View all projects
            <span
              class="material-icons text-sm ml-1 group-hover:translate-x-1 transition-transform"
              >arrow_forward</span
            >
          </a>
        </div>
        <ProjectCard />
      </div>
    </section>

  

    <!-- 2. BENTO ABOUT SECTION -->
    <section id="sobre-mi" class="py-32">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 auto-rows-[200px]">
        <div
          class="md:col-span-2 md:row-span-2 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[2.5rem] p-10 flex flex-col justify-end"
        >
          <h3 class="text-3xl font-bold mb-4">Mi Filosofía</h3>
          <p class="text-slate-500 dark:text-slate-400 text-lg">
            No solo escribo código; diseño soluciones. Me obsesiona el
            rendimiento, la accesibilidad y los detalles que hacen que una web
            se sienta "viva".
          </p>
        </div>

        <div
          class="bg-indigo-600 rounded-[2.5rem] p-8 text-white flex flex-col justify-center items-center text-center"
        >
          <span class="text-5xl font-black italic">+3</span>
          <p class="font-medium opacity-80">Años de experiencia</p>
        </div>

        <div
          class="bg-slate-100 dark:bg-slate-800 rounded-[2.5rem] p-8 flex items-center justify-center"
        >
          <p class="text-xl font-bold text-center">Madrid, España 📍</p>
        </div>

        <div
          class="md:col-span-3 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-[2.5rem] p-8 flex items-center justify-between"
        >
          <p class="text-xl font-bold italic">
            "El código es poesía escrita para que la entiendan las máquinas."
          </p>
          <div class="flex gap-2">
            <div class="h-12 w-12 rounded-full bg-slate-200 dark:bg-slate-700">
            </div>
            <div class="h-12 w-12 rounded-full bg-slate-200 dark:bg-slate-700">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. CONTACT PREVIEW -->
    <section class="py-32 text-center">
      <h2 class="text-5xl md:text-7xl font-bold mb-8">¿Hablamos?</h2>
      <p class="text-xl text-slate-500 mb-12">
        Estoy siempre abierto a escuchar nuevas ideas y proyectos interesantes.
      </p>
      <a
        href="mailto:tu@email.com"
        class="text-3xl md:text-4xl font-black text-indigo-600 underline underline-offset-8 decoration-2 hover:text-indigo-500 transition-colors"
      >
        hola@tunombre.com
      </a>
    </section>
  </main>

  <footer
    class="py-12 border-t border-slate-200 dark:border-slate-800 text-center text-slate-500 text-sm"
  >
    <p>© 2025 Diseñado y programado por Javier.</p>
  </footer>
</Layout>

<style>
  /* Suavizar el scroll al hacer clic en los enlaces del nav */
  html {
    scroll-behavior: smooth;
  }
</style>
