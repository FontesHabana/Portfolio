---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from 'astro:content';

import GitHubIcon from "../../components/icons/GitHubIcon.astro";
import GitIcon from "../../components/icons/GitIcon.astro";
import PythonIcon from "../../components/icons/PythonIcon.astro";
import CSIcon from  "../../components/icons/CSIcon.astro";
import CPPIcon from "../../components/icons/CPPIcon.astro";
import JsIcon from "../../components/icons/JsIcon.astro";
import HTMLIcon from "../../components/icons/HTMLIcon.astro";
import CSSIcon from "../../components/icons/CSSIcon.astro";
import ReactIcon from "../../components/icons/ReactIcon.astro";
import AstroIcon from "../../components/icons/AstroIcon.astro";
import TailwindIcon from "../../components/icons/TailwindIcon.astro";
import StreamlitIcon from "../../components/icons/StreamlitIcon.astro";

const work =  await getCollection('work', ({ id }) => {
    return id.startsWith('es/');
});

// Opcional: Ordenar por fecha (del más reciente al más antiguo)
work.sort((a, b) => Date.parse(b.data.startdate) - Date.parse(a.data.startdate));

const studies = await getCollection('studies', ({ id }) => {
    return id.startsWith('es/');
});
studies.sort((a,b)=>  Date.parse(b.data.startdate) - Date.parse(a.data.startdate))
---

<Layout title="Sobre mí | Javier Fontes">

<div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">

<main class="relative sans flex-grow w-full bg-purple-50 mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <!-- Blobs decorativos (Corrección de clases y optimización) -->
    <div class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-purple-200  blur-3xl opacity-50 pointer-events-none"></div>
    <div class="absolute top-[150px] left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-orange-100  blur-3xl opacity-50 pointer-events-none"></div>

<div class="flex-grow w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <!-- Hero Section -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-24">
        <div class="order-2 md:order-1 flex flex-col gap-6">
            <h1 class="display text-3xl md:text-4xl lg:text-6xl font-medium leading-tight mb-1 bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-slate-700 to-slate-900 ">
                Estructurando <span class="italic text-[#6366f1] font-serif">soluciones</span> digitales.
            </h1>
            <div class="prose prose-lg text-slate-600 leading-relaxed">
                <p>
                    Soy Javier, desarrollador de software enfocado en la arquitectura de código limpio y la resolución de problemas complejos. Me especializo en el desarrollo Full-Stack, transformando ideas en aplicaciones robustas, eficientes y preparadas para crecer.
                </p>
                <p class="mt-4 text-base">
                    Desde la lógica de sistemas hasta el diseño de interfaces intuitivas, conecto la solidez técnica con una experiencia de usuario fluida. Mi objetivo es desarrollar productos digitales con propósito, donde la precisión del código potencie el valor real del software.
                </p>
            </div>
            <div class="relative flex flex-col sm:flex-row gap-4">
                <a class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 bg-slate-900  text-white  font-medium rounded-full hover:bg-slate-800  transition-all duration-300" href="/Projects">
                    Ver Proyectos
                </a>
                <a class="w-full sm:w-auto inline-flex bg-slate-100 items-center justify-center px-8 py-3.5 border border-slate-300 text-slate-700  font-medium rounded-full hover:bg-slate-50  transition-all duration-300" href="/cv.pdf">
                    Descargar CV
                </a>
            </div>
        </div>
        <div class="order-1 md:order-2 flex justify-center md:justify-end">
            <div class="relative w-full max-w-sm aspect-square">
                <div class="absolute inset-0 bg-blue-200  rounded-2xl rotate-3 transform transition-transform"></div>
                <div class="absolute inset-0 bg-slate-100  rounded-2xl -rotate-3 transform transition-transform"></div>
                <div class="relative h-full w-full overflow-hidden rounded-2xl bg-white shadow-xl border border-slate-100 ">
                    <img src="/assets/yo.webp" alt="Foto de perfil de Javier Fontes" class="w-full h-full object-cover">
                </div>
            </div>
        </div>
    </section>

    <div class="w-full h-px bg-slate-200  mb-20"></div>

    <!-- Stack Tecnológico -->
    <section class="mb-24">                                 
        <div class="flex flex-col md:flex-row md:items-start gap-12">
            <div class="md:w-1/3 sticky top-24">
                <h2 class="text-4xl display tracking-tight text-slate-900  mb-4">Stack Tecnológico</h2>
                <p class="text-slate-600  leading-relaxed">
                    Enfocado en soluciones modernas y escalables, seleccionando siempre la herramienta más eficiente para cada desafío mediante un aprendizaje continuo.
                </p>
            </div>
            <div class="md:w-2/3 grid grid-cols-1 sm:grid-cols-2 gap-8">
                <!-- Lenguajes -->
                <div class="space-y-4">
                    <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-600 ">Lenguajes</h3>
                     <div class="flex flex-wrap gap-2">
                        <span class="flex bg-blue-100 py-1 px-4 rounded-full"> <PythonIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">Python</p></span>
                        <span class="flex bg-purple-200 py-1 px-4 rounded-full"> <CSIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">C#</p></span>
                        <span class="flex bg-purple-200 py-1 px-4 rounded-full"> <CPPIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">C++</p></span>
                        <span class="flex bg-yellow-100 py-1 px-4 rounded-full"> <JsIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">JavaScript</p></span>
                        <span class="flex bg-red-100 py-1 px-4 rounded-full"> <HTMLIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">HTML</p></span>
                        <span class="flex bg-blue-100 py-1 px-4 rounded-full"> <CSSIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">CSS</p></span>
                    </div>
                </div>
                <!-- Frameworks -->
                <div class="space-y-4">
                    <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-600 ">Frameworks</h3>
                     <div class="flex flex-wrap gap-2">
                        <span class="flex bg-blue-100 py-1 px-4 rounded-full"> <ReactIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">React</p></span>
                        <span class="flex bg-slate-200 py-1 px-4 rounded-full"> <TailwindIcon class="w-5 h-5"/> <p class="ml-2 font-semibold ">TailwindCSS</p></span>
                        <span class="flex bg-purple-200 py-1 px-4 rounded-full"> <AstroIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">Astro</p></span>
                        <span class="flex bg-red-100 py-1 px-4 rounded-full"> <StreamlitIcon class="w-5 h-5"/> <p class="ml-2 font-semibold">Streamlit</p></span>
                    </div>
                </div>
                <!-- Herramientas -->
                <div class="space-y-4">
                    <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-600 ">Herramientas & DevOps</h3>
                    <div class="flex flex-wrap gap-2">
                        <span class="flex items-center bg-red-100 py-1.5 px-4 rounded-full text-sm font-semibold"> <GitIcon class="w-5 h-5 mr-2"/> Git</span>
                        <span class="flex items-center bg-slate-300 py-1.5 px-4 rounded-full text-sm font-semibold"> <GitHubIcon class="w-5 h-5 mr-2"/> GitHub</span>
                    </div>
                </div>
                <!-- Diseño -->
                <div class="space-y-4">
                    <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-600 ">Diseño</h3>
                    <div class="flex flex-wrap gap-2">
                        <span class="flex items-center bg-blue-300 py-1.5 px-4 rounded-full text-sm font-semibold"> UI/UX</span>
                        <span class="flex items-center bg-red-200 py-1.5 px-4 rounded-full text-sm font-semibold"> Diseño Responsive</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Experiencia Section -->
    <section class="mb-12">
        <div class="flex flex-col md:flex-row md:items-start gap-12">
            <div class="md:w-1/3 sticky top-24">
                <h2 class="text-4xl display tracking-tight text-slate-900  mb-4">Experiencia</h2>
                <p class="text-slate-600  leading-relaxed">
                    Desarrollo y mantenimiento de ecosistema digital corporativo. Responsable de arquitectura web, implementación de automatización y soporte técnico especializado.
                </p>
            </div>
            <div class="md:w-2/3 space-y-8">
                {
                    work.map((item) => {
                        const { slug, data } = item;
                        const { company, position, startdate, enddate, achivements } = data;
                        return (
                            <div class="relative pl-8 border-l border-slate-200  space-y-2" key={slug}>
                                <div class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-primary ring-4 ring-white "></div>
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                                    <h3 class="text-lg font-bold text-slate-900 ">{position}</h3>
                                    <span class="text-sm font-medium text-slate-500  tabular-nums">{startdate} — {enddate}</span>
                                </div>
                                <div class="text-primary font-medium text-sm">{company}</div>
                                {achivements && Array.isArray(achivements) && (
                                    <ul class="list-disc list-outside ml-4 mt-2 space-y-1 text-sm text-slate-600  marker:text-slate-400">
                                        {achivements.map((achievement) => (
                                            <li>{achievement}</li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Estudios Section -->
    <section class="mb-12">
        <div class="flex flex-col md:flex-row md:items-start gap-12">
            <div class="md:w-1/3 sticky top-24">
                <h2 class="text-4xl display tracking-tight text-slate-900  mb-4">Estudios</h2>
                <p class="text-slate-600  leading-relaxed">
                    Trayectoria académica centrada en la resolución de problemas de alta complejidad. Mi perfil integra la base lógica de la matemática competitiva con el rigor del análisis algorítmico.
                </p>
            </div>
            <div class="md:w-2/3 space-y-8">
                {
                    studies.map((item) => {
                        const { slug, data } = item;
                        const { company, level, startdate, enddate, achivements } = data;
                        return (
                            <div class="relative pl-8 border-l border-slate-200  space-y-2" key={slug}>
                                <div class="absolute -left-[5px] top-2 h-2.5 w-2.5 rounded-full bg-primary ring-4 ring-white "></div>
                                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1">
                                    <h3 class="text-lg font-bold text-slate-900 ">{level}</h3>
                                    <span class="text-sm font-medium text-slate-500  tabular-nums">{startdate} — {enddate}</span>
                                </div>
                                <div class="text-primary font-medium text-sm">{company}</div>
                                {achivements && Array.isArray(achivements) && (
                                    <ul class="list-disc list-outside ml-4 mt-2 space-y-1 text-sm text-slate-600  marker:text-slate-400">
                                        {achivements.map((achievement) => (
                                            <li>{achievement}</li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>
</div>

</main>

  <Footer />
</div>
</Layout>