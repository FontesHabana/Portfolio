---
import Layout from "../../layouts/Layout.astro";
import {
  Github,
  Linkedin,
  ExternalLink,
  Code2,
  Terminal,
  Cpu,
  Globe,
  Mail,
} from "lucide-react";
import Dropdown from "../../components/DropDown.jsx";
import Header from "../../components/HeaderEs.astro";
import Footer from "../../components/Footer.astro"
import ProjectCard from "../../components/ProjectCard.astro";
import Arrow from "../../components/icons/Arrow.astro";
import  MailIcon  from "../../components/icons/MailIcon.astro";
---

<Layout title="Javier Fontes | Fullstack Developer">
  <Header/>
  
  <main class="relative z-10 sans mx-auto overflow-hidden">
    
    <!-- 1. Projects Section -->
    <section class="py-20 md:py-24 bg-white " id="work">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
          <div>
            <h2 class="display text-3xl md:text-5xl text-slate-900  mb-3">
              Algunos Trabajos
            </h2>
            <p class="text-slate-500  max-w-xl text-lg">
             Muestras de mi trabajo en desarrollo de software y diseño funcional.
            </p>
          </div>
          
          <!-- En móvil el botón se ve, en desktop mantiene su estilo -->
          <a
            class="inline-flex md:hidden items-center text-primary-600 font-medium hover:text-indigo-400 transition-colors"
            href="./es/Projects"
          >
            Ver todos los proyectos <Arrow class="w-4 h-4 ml-2"/>
          </a>
        </div>

        <ProjectCard lang="es" onlyMain={true}/>

        <a
          class="hidden md:flex mt-20 items-center text-primary font-medium text-xl hover:text-indigo-400 transition-colors group"
          href="./es/project"
        >
          Ver todos los proyectos
          <div class="mt-1 group-hover:translate-x-4 transition-transform">
            <Arrow class="w-5 h-5"/>
          </div>
        </a>
      </div>
    </section>

    <!-- 2. ABOUT SECTION (Corregido px-40) -->
    <section class="py-20 md:py-32 bg-slate-50  overflow-hidden relative" id="about">
      <!-- Blobs decorativos -->
      <div class="absolute -bottom-10 right-0 -mr-20 -mb-20 w-72 h-72 md:w-96 md:h-96 rounded-full bg-purple-200  blur-3xl opacity-50 pointer-events-none"></div>
      <div class="absolute top-0 left-0 -ml-20 -mb-20 w-64 h-64 md:w-80 md:h-80 rounded-full bg-orange-100  blur-3xl opacity-50 pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-16 relative">
        <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-start">
          <div class="w-full lg:w-2/3">
            <h2 class="display text-3xl md:text-5xl text-slate-900  mb-8">
               Sencillez técnica para problemas complejos.
            </h2>
            <div class="prose prose-lg  text-slate-600 ">
              <p class="mb-6">
                Soy Javier. Como estudiante de Ciencias de la Computación, paso gran parte de mi tiempo intentando entender cómo las herramientas digitales pueden hacernos la vida un poco más fácil. Creo que la programación es, ante todo, una forma de ayudar a los demás a resolver problemas cotidianos.
              </p>
              <p>
                No busco crear el sistema más complejo, sino el que sea más útil y fácil de usar. En cada proyecto que hago, trato de aprender algo nuevo y de escribir un código limpio y escalable.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. CONTACT PREVIEW -->
    <section class="py-24 bg-white  px-6 text-center overflow-hidden relative" id="contact">
      <div class="absolute top-0 right-0 -mr-20 -mt-40 w-80 h-80 md:w-96 md:h-96 rounded-full bg-purple-200  blur-3xl opacity-50 pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-72 h-72 md:w-80 md:h-80 rounded-full bg-orange-100  blur-3xl opacity-50 pointer-events-none"></div>
      
      <div class="relative max-w-3xl mx-auto">
        <h2 class="display text-4xl md:text-6xl text-slate-900  mb-6">¿Listo para crear algo auténtico?</h2>
        <p class="text-lg md:text-xl text-slate-600  mb-10">
          Actualmente me encuentro disponible para proyectos independientes y oportunidades a tiempo completo.
        </p>
        
        <div class="flex flex-col items-center gap-6">
          <a class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 bg-slate-900  text-white  font-medium text-lg rounded-full shadow-lg hover:scale-105 transition-transform"  
             href="mailto:javierfontbas@gmail.com?subject=Contacto%20desde%20tu%20web">
            Di Hola
            <MailIcon class="w-6 h-6 ml-2"></MailIcon>
          </a>
          <p class="text-lg font-mono text-slate-500">
            javierfontbas@gmail.com
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>