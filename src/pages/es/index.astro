---
import Layout from "../../layouts/Layout.astro";
//import BackgroundLines from '../components/BackgroundLines.jsx';
import {
  Github,
  Linkedin,
  ExternalLink,
  Code2,
  Terminal,
  Cpu,
  Globe,
  Mail,
} from "lucide-react";
import Dropdown from "../../components/DropDown.jsx";
import Header from "../../components/HeaderEs.astro";
import Footer from "../../components/Footer.astro"
import ProjectCard from "../../components/ProjectCard.astro";
import Arrow from "../../components/icons/Arrow.astro";
import  MailIcon  from "../../components/icons/MailIcon.astro";








---

<Layout title="Tu Nombre | Fullstack Developer">
  <!-- Menu -->
  
  <!--Presentation -->
  <Header/>
  <main class="relative z-10 sans  mx-auto overflow-hidden">
    <!-- 1.Projects -->
    <section class="py-20 bg-white dark:bg-slate-900/50" id="work">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-end justify-between mb-12">
          <div>
            <h2
              class="display text-3xl md:text-4xl text-slate-900 dark:text-white mb-2"
            >
              Algunos Trabajos
            </h2>
            <p class="text-slate-500 dark:text-slate-500">
             Muestras de mi trabajo en desarrollo de software y diseño funcional.
            </p>
          </div>
         
        </div>
        <ProjectCard onlyMain={true}/>
       <a
            class="hidden mt-20 md:flex items-center text-primary font-medium  text-xl hover:text-indigo-400 transition-colors group"
            href="./Projects"
          >
            Ver todos los proyectos
            <div class="mt-1 group-hover:translate-x-4 transition-transform">
              
            <Arrow class="w-5 h-5"/>
            </div>
          </a>
      </div>
    </section>

    <!-- 2. BENTO ABOUT SECTION -->
    <section class="py-30   bg-slate-50 dark:bg-slate-800/50 overflow-hidden  relative" id="about">
      <div class="mx-auto px-40 ">
        <div class="absolute -bottom-10 right-0 -mr-20 -mb-20 w-96 h-96 rounded-full bg-purple-200 dark:bg-indigo-900/30 blur-3xl opacity-50 pointer-events-none"></div>
    <div class="absolute top-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-orange-100 dark:bg-purple-900/20 blur-3xl opacity-50 pointer-events-none"></div>
        <div class=" relative flex flex-col lg:flex-row gap-16 items-start">
          <div class="lg:w-1/2">
            <h2
              class="display text-4xl md:text-4xl text-slate-900 dark:text-white mb-6"
            >
               Sencillez técnica para problemas complejos.
            </h2>
            <div
              class="prose text-xl dark:prose-invert text-slate-600 dark:text-slate-400"
            >
              <p class="mb-4">
                     Soy Javier. Como estudiante de Ciencias de la Computación, paso gran parte de mi tiempo intentando entender cómo las herramientas digitales pueden hacernos la vida un poco más fácil. Creo que la programación es, ante todo, una forma de ayudar a los demás a resolver problemas cotidianos.
              </p>
              <p>
                No busco crear el sistema más complejo, sino el que sea más útil y fácil de usar. En cada proyecto que hago, trato de aprender algo nuevo y de escribir un código limpio y escalable. Para mí, el éxito de un trabajo no está en lo sofisticado que parezca, sino en que funcione bien para quien lo necesita.
              </p>
            </div>
            
          </div>
        </div>
      </div>
    </section>



      <!-- 5. CONTACT PREVIEW -->
    <section class="py-24 bg-slate-50 px-6 text-center overflow-hidden relative " id="contact">
      <div class="absolute top-0 right-0 -mr-20 -mt-40 w-96 h-96 rounded-full bg-purple-200 dark:bg-indigo-900/30 blur-3xl opacity-50 pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-orange-100 dark:bg-purple-900/20 blur-3xl opacity-50 pointer-events-none"></div>
<div class="relative max-w-3xl mx-auto">
  
<h2 class="display text-4xl md:text-5xl text-slate-900 dark:text-white mb-6">¿Listo para crear algo auténtico?</h2>
<p class="text-lg text-slate-600 dark:text-slate-400 mb-10">
                Actualmente me encuentro disponible para proyectos independientes y oportunidades a tiempo completo.
            </p>
<a class="inline-flex items-center justify-center px-8 py-4 bg-slate-900 text-white font-medium text-lg rounded-full shadow-lg hover:bg-slate-800 transition-colors"  href="mailto: javierfontbas@gmail.com?subject=Contacto%20desde%20tu%20web&body=Hola%20Javier%2C%0A%0AMe%20gustar%C3%ADa%20hablar%20sobre%20...">
                Di Hola
               <MailIcon class="w-6 h-6  ml-2"></MailIcon>
</a>
<p class="text-lg text-slate-600 dark:text-slate-400 mt-3">
                javierfontbas@gmail.com
            </p>
</div>
</section>

  
    
  </main>

  <Footer />
</Layout>

<style>
  /* Suavizar el scroll al hacer clic en los enlaces del nav */
  html {
    scroll-behavior: smooth;
  }
</style>
