---
import Layout from "../../layouts/Layout.astro";
import {
  Github,
  Linkedin,
  ExternalLink,
  Code2,
  Terminal,
  Cpu,
  Globe,
} from "lucide-react";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";
---

<Layout title="Javier Fontes | Proyectos">
  <!-- Agregamos overflow-x-hidden al contenedor principal para evitar scroll lateral por los blobs -->
  <main class="relative bg-purple-50 dark:bg-slate-950 z-10 w-full min-h-screen overflow-x-hidden">
    
    <!-- Header Section -->
    <header class="relative w-full pt-20 pb-12 md:pt-32 md:pb-20 lg:pt-48 lg:pb-32 px-6">
      <!-- Blobs decorativos optimizados para móvil (tamaño reducido en pantallas pequeñas) -->
      <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 md:w-96 md:h-96 rounded-full bg-purple-200 dark:bg-indigo-900/30 blur-3xl opacity-50 pointer-events-none"></div>
      <div class="absolute top-[10%] left-0 -ml-16 w-64 h-64 md:w-96 md:h-96 rounded-full bg-purple-200 dark:bg-indigo-900/30 blur-3xl opacity-40 pointer-events-none"></div>
      <div class="absolute top-[35%] right-0 -mr-16 w-56 h-56 md:w-80 md:h-80 rounded-full bg-orange-100 dark:bg-purple-900/20 blur-3xl opacity-40 pointer-events-none"></div>

      <div class="max-w-7xl mx-auto relative z-10">
        <div class="max-w-4xl">
          <h1
            class="display text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-medium leading-[1.1] mb-6 md:mb-8 bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-slate-700 to-slate-900 dark:from-white dark:via-slate-200 dark:to-slate-400"
          >
           Trabajo y 
            <span class="italic text-[#6366f1] font-serif">proyectos.</span>
          </h1>
          <p
            class="text-base sm:text-lg md:text-xl text-slate-600 dark:text-slate-400 leading-relaxed max-w-2xl"
          >
            Una recopilación de soluciones digitales, experimentos técnicos y herramientas construidas con atención al detalle. Mi objetivo es transformar la complejidad en algo funcional, sencillo y útil.
          </p>
        </div>
      </div>
    </header>

    <!-- Projects Section -->
    <!-- mx-auto y px-6 aseguran que el contenido esté centrado y respire en móviles -->
    <section class="max-w-7xl mx-auto px-6 pb-24 relative z-10" id="projects">
      <div class="w-full">
        {/* 
           IMPORTANTE: Asegúrate de que dentro de <ProjectCard /> 
           estés usando un layout de grid o flex que no fuerce el ancho. 
           Por ejemplo: class="grid grid-cols-1 md:grid-cols-2 gap-8"
        */}
        <ProjectCard lang="es" onlyMain={false}/>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Suaviza la fuente para títulos grandes */
  .display {
    word-spacing: -0.05em;
  }
</style>