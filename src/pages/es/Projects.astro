---
import Layout from "../../layouts/Layout.astro";
//import BackgroundLines from '../../components/BackgroundLines.jsx';
import {
  Github,
  Linkedin,
  ExternalLink,
  Code2,
  Terminal,
  Cpu,
  Globe,
} from "lucide-react";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProjectCard from "../../components/ProjectCard.astro";
---

<Layout title="Tu Nombre | Fullstack Developer">
  <!-- Menu -->

  <main class="relative bg-purple-50 z-10 w-full">
    <div class="relative w-full  pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden">
      
      
      
      <div
        class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-purple-200 dark:bg-indigo-900/30 blur-3xl opacity-50 pointer-events-none"
      >
      </div>
      <div
        class="absolute top-200 left-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-purple-200 dark:bg-indigo-900/30 blur-3xl opacity-50 pointer-events-none"
      >
      </div>
      <div
        class="absolute top-300 right-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-orange-100 dark:bg-purple-900/20 blur-3xl opacity-50 pointer-events-none"
      >
      </div>
      <div
        class="absolute top-400 right-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-purple-200 dark:bg-indigo-900/30 blur-3xl opacity-50 pointer-events-none"
      >
      </div>
      <div
        class="absolute top-500 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-orange-100 dark:bg-purple-900/20 blur-3xl opacity-50 pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-orange-100 dark:bg-purple-900/20 blur-3xl opacity-50 pointer-events-none"
      >
      </div>
      
      
      
      
      
      
      
      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="max-w-4xl">
          <h1
            class="display text-5xl md:text-7xl lg:text-8xl font-medium leading-tight mb-8 bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-slate-700 to-slate-900 dark:from-white dark:via-slate-200 dark:to-slate-400"
          >
           Trabajo y 
            <span class="italic text-[#6366f1]  font-serif">proyectos.</span>
          </h1>
          <p
            class="text-lg md:text-xl text-slate-600 dark:text-slate-400 leading-relaxed max-w-2xl mb-10"
          >
            Una recopilación de soluciones digitales, experimentos técnicos y herramientas construidas con atención al detalle. Mi objetivo con cada una de ellas es transformar la complejidad en algo funcional, sencillo y útil.
          </p>
        </div>
      </div>
      <section class="mx-20 relative" id="projects">
        
      <ProjectCard onlyMain={false}/>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
