---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';

export async function getStaticPaths() {
  // Filtramos para que solo tome los archivos dentro de la carpeta 'es/'
  const projects = await getCollection('projects', ({ id }) => {
    return id.startsWith('es/');
  });
  
  return projects.map(entry => ({
    // Extraemos solo el nombre del archivo para el slug de la URL
    params: { slug: entry.slug.split('/').pop() }, 
    props: { project: entry },
  }));
}
const { project } = Astro.props;
const { title, tech, github, deploy, gallery } = project.data;
const { Content } = await project.render();
---

<Layout title={title}> <!-- Corregido: sin backticks innecesarios ni escapes -->
  <main class="relative z-10 w-full">
    
    <div class="flex flex-col lg:flex-row relative w-full lg:h-screen pt-24 pb-10 lg:pt-20 lg:pb-10 overflow-x-hidden overflow-y-hidden">
      
      <!-- Luces de fondo -->
      <div class="absolute top-0 right-0 -mr-20 -mt-20 w-64 h-64 md:w-96 md:h-96 rounded-full bg-purple-200 dark:bg-indigo-900/30 blur-3xl opacity-50 pointer-events-none"></div>
      <div class="absolute bottom-0 left-0 -ml-20 -mb-20 w-56 h-56 md:w-80 md:h-80 rounded-full bg-orange-100 dark:bg-purple-900/20 blur-3xl opacity-50 pointer-events-none"></div>
      
      <!-- Columna Izquierda: Información -->
      <div class="w-full lg:w-1/2 flex items-center px-6 md:px-10 lg:px-20 mb-12 lg:mb-0">
        <div class="max-w-4xl relative z-10">
          <h1 class="display text-4xl md:text-6xl lg:text-7xl font-medium leading-tight mb-4 bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-slate-700 to-slate-900 dark:from-white dark:via-slate-200 dark:to-slate-400">
            {title}           
          </h1>
          
          <div class="flex flex-wrap gap-2 items-center mb-6">
            {tech.map((t: string, i: number) => (
              <Fragment key={t}>
                {i > 0 && <span class="hidden sm:inline rounded-full w-1 h-1 bg-slate-400" ></span>}
                <span class="text-sm md:text-xl font-medium uppercase py-1 text-slate-600 dark:text-slate-300 rounded-md">{t}</span>
              </Fragment>
            ))}
          </div>

          <div class="text-base md:text-lg lg:text-xl text-slate-600 dark:text-slate-400 leading-relaxed max-w-2xl mb-8 prose dark:prose-invert">
             <Content />
          </div>

          <div class="flex flex-col sm:flex-row gap-4">
            {github && (
              <a href={github} target="_blank" class="inline-flex items-center justify-center px-8 py-3.5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-medium rounded-full hover:bg-slate-800 dark:hover:bg-slate-100 transition-all duration-300 text-center">
                GitHub
              </a>
            )}
             {deploy && (
              <a href={deploy} class="inline-flex items-center justify-center px-8 py-3.5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-medium rounded-full hover:bg-slate-800 dark:hover:bg-slate-100 transition-all duration-300 text-center">
                Ver proyecto
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Columna Derecha: Galería -->
      <div class="relative w-full lg:w-1/2 h-auto lg:h-full overflow-y-auto scroll-smooth  snap-mandatory no-scrollbar px-4">
        <div class="h-5"></div> 
        {gallery && gallery.map((src: string) => (
            <div class="w-full max-w-[580px] mb-6 md:mb-10 mx-auto snap-center shrink-0">
                 <img 
                    src={src} 
                    alt={title} 
                    class="w-full h-auto rounded-2xl shadow-xl border border-slate-200 dark:border-slate-800" 
                    loading="lazy"
                 />
            </div>
        ))}
        <div class="h-10 lg:hidden"></div>
      </div>
      
    </div> 
  </main>
</Layout>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>