---
import Layout from "../../layouts/Layout.astro";
//import BackgroundLines from '../components/BackgroundLines.jsx';

import Dropdown from "../../components/DropDown.jsx";
import Footer from "../../components/Footer.astro";




import { getEntry } from "astro:content";
import { getEntries } from "astro:content";
import { promise } from "astro:schema";
const project=await getEntry('projects',"06sagrada")


---

<Layout title="Tu Nombre | Fullstack Developer">
  <!-- Menu -->
  <nav class="fixed top-0 right-0 w-full justify-end z-50 flex p-6">
    <Dropdown client:load />
  </nav>
  <main class="relative z-10 w-full">
    <div class="flex   justify-center relative w-full h-screen  pt-32 pb-20 lg:pt-20 lg:pb-10 overflow-hidden">
      
      
      
      <div
        class="absolute top-0 right-0 -mr-20 -mt-20 w-96 h-96 rounded-full bg-purple-200 dark:bg-indigo-900/30 blur-3xl opacity-50 pointer-events-none"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 rounded-full bg-orange-100 dark:bg-purple-900/20 blur-3xl opacity-50 pointer-events-none"
      >
      </div>
      
      
      
      <div class="w-1/2 mt-15 mx-10">
       
<div class="max-w-7xl mx-auto px-6 relative z-10">
<div class="max-w-4xl">
<h1 class="display text-2xl md:text-6xl lg:text-7xl font-medium leading-tight mb-1 bg-clip-text text-transparent bg-gradient-to-r from-slate-900 via-slate-700 to-slate-900 dark:from-white dark:via-slate-200 dark:to-slate-400">
         {project.data.title}           
</h1>
<div class=" flex gap-2  items-center">
  {project.data.tech.map((tech: unknown,i: number)=>(
    <>
    {i>0 && <span class="rounded-full  w-1 h-1 bg-slate-400" ></span>}
    
<span class="text-xl font-medium uppercase py-1   text-slate-600 dark:text-slate-300 rounded-md">{tech}</span>
    </>
  ))}
</div>
<p class="text-lg md:text-xl text-slate-600 dark:text-slate-400 leading-relaxed max-w-2xl mb-5">
                   {project.body}
                </p>

</div>
<div class="flex flex-col sm:flex-row gap-4">
{project?.data.github && <a class="inline-flex items-center justify-center px-8 py-3.5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-medium rounded-full hover:bg-slate-800 dark:hover:bg-slate-100 transition-all duration-300" href={project?.data.github}>
                        github
                    </a>}
{project?.data.deploy && <a class="inline-flex items-center justify-center px-8 py-3.5 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-medium rounded-full hover:bg-slate-800 dark:hover:bg-slate-100 transition-all duration-300" href={project?.data.deploy}>
                        Deploy
                    </a>}

</div>
</div>

      </div>


      


      <div class="relative w-1/2 h-full overflow-y-auto scroll-smooth pt-130 flex flex-col items-center  justify-center no-scrollbar ">
        {project.data.gallery.map(src=>(
            <div class="h-[380px] w-[98%] max-w-[520px] p-3  rounded-xl">
             <img src={src} alt="AlternaWorld" class="w-full h-full object-cover rounded-xl" loading="lazy"/>
             </div>
        ))}
       
       
      </div>








      
      
      
      
      
    </div> 
  </main>

</Layout>
